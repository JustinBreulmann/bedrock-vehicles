{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.ambulance_seat": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "riding": "(1.0)"
                  }
               ],
               "on_entry": [
                  "/function ash_heavyveh_seat"
               ]
            },
            "riding": {
               "transitions": [
                  {
                     "default": "query.has_rider"
                  }
               ],
               "on_entry": [
                  "/function ash_heavyveh_seat"
               ]
            }
         }
      },
      "controller.animation.ambulance_startup": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "startup": "query.has_rider"
                  }
               ]
            },
            "startup": {
               "transitions": [
                  {
                     "default": "!query.has_rider"
                  }
               ],
               "on_entry": [
                  "/playsound vehicle.ambulance.startup @a[r=50] ~~~",
                  "/playsound vehicle.ambulance.startup @a[r=50] ~~~",
                  "/playsound vehicle.ambulance.startup @a[r=50] ~~~"
               ]
            }
         }
      },
      "controller.animation.firetruck1_startup": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "startup": "query.has_rider"
                  }
               ]
            },
            "startup": {
               "transitions": [
                  {
                     "default": "!query.has_rider"
                  }
               ],
               "on_entry": [
                  "/playsound vehicle.firetruck1.startup @a[r=50] ~~~",
                  "/playsound vehicle.firetruck1.startup @a[r=50] ~~~",
                  "/playsound vehicle.firetruck1.startup @a[r=50] ~~~"
               ]
            }
         }
      },
      "controller.animation.heavy_startup": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "startup": "query.has_rider"
                  }
               ]
            },
            "startup": {
               "transitions": [
                  {
                     "default": "!query.has_rider"
                  }
               ],
               "on_entry": [
                  "/playsound vehicle.heavy.startup @a[r=50] ~~~",
                  "/playsound vehicle.heavy.startup @a[r=50] ~~~",
                  "/playsound vehicle.heavy.startup @a[r=50] ~~~"
               ]
            }
         }
      },
      "controller.animation.heavy_meter": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "meter": "query.ground_speed > 3"
                  }
               ]
            },
            "meter": {
               "transitions": [
                  {
                     "default": "query.ground_speed < 3"
                  }
               ],
               "on_entry": [
                  "/function heavymeter"
               ]
            }
         }
      },
      "controller.animation.heavy_pecutan": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "pecutan": "query.ground_speed > 3" 
                  }
               ]
            },
            "pecutan": {
               "transitions": [
                  {
                     "default": "query.ground_speed < 3"
                  }
               ],
               "on_entry": [
                  "@s velocity_1",
                  "/playsound vehicle.heavy.adv_drive @a[r=5]"
               ]
            }
         }
      },
      "controller.animation.heavy_soundstop": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "startup": "query.ground_speed < 3" 
                  }
               ]
            },
            "startup": {
               "transitions": [
                  {
                     "default": "query.ground_speed > 3"
                  }
               ],
               "on_entry": [
                  "/stopsound @a[r=5] vehicle.heavy.adv_drive",
                  "@s velocity_stationary"
               ]
            }
         }
      },
      "controller.animation.heavy_soundstop2": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "startup": "!query.has_rider"
                  }
               ]
            },
            "startup": {
               "transitions": [
                  {
                     "default": "query.has_rider"
                  }
               ],
               "on_entry": [
                  "/stopsound @a[r=5] vehicle.heavy.adv_drive"
               ]
            }
         }
      },
      "controller.animation.heavy_roadkill": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "roadkill": "query.ground_speed > 17.6" 
                  }
               ]
            },
            "roadkill": {
               "transitions": [
                  {
                     "default": "query.ground_speed > 17.6"
                  }
               ],
               "on_entry": [
                  "@s roadkill"
               ]
            }
         }
      },
      "controller.animation.heavy_explode": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "ono": "!query.is_alive"
                  }
               ]
            },
            "ono": {
               "transitions": [
                  {
                     "default": "query.is_alive"
                  }
               ],
               "on_entry": [
                  "/summon ashminggu:vehicle_explosion",
                  "/summon ashminggu:vehicle_explosion",
                  "/particle minecraft:huge_explosion_emitter ~~~"
               ]
            }
         }
      }
   }
}