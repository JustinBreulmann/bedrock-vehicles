/* 0.1000 mcm = 4.4ms⁻¹
   0.2000 mcm = 8.8ms⁻¹
   0.0227 mcm = 1.0ms⁻¹	

   query.ground_speed values are in ms⁻¹   */
{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.pb389_pecutan": {
			"states": {
				"default": {
					"transitions": [
						{
							"pecutan": "query.ground_speed > 3" 
						}
					]
				},
				"pecutan": {
					"transitions": [
						{
							"default": "query.ground_speed < 3"
						}
					],
					"on_entry": [
						"@s velocity_1",
						"/playsound vehicle.pb389.adv_drive @a[r=5]"
					]
				}
			}
		},
		"controller.animation.pb389_roadkill": {
			"states": {
				"default": {
					"transitions": [
						{
							"roadkill": "query.ground_speed > 18.26"
						}
					]
				},
				"roadkill": {
					"transitions": [
						{
							"default": "query.ground_speed > 18.26"
						}
					],
					"on_entry": [
						"@s roadkill"
					]
				}
			}
		},
		"controller.animation.pb389_meter": {
			"states": {
				"default": {
					"transitions": [
						{
							"meter": "query.ground_speed > 3"
						}
					]
				},
				"meter": {
					"transitions": [
						{
							"default": "query.ground_speed < 3"
						}
					],
					"on_entry": [
						"/function pb389_meter"
					]
				}
			}
		},
		"controller.animation.pb389_soundstop": {
			"states": {
				"default": {
					"transitions": [
						{
							"startup": "query.ground_speed < 3" 
						}
					]
				},
				"startup": {
					"transitions": [
						{
							"default": "query.ground_speed > 3"
						}
					],
					"on_entry": [
						"/stopsound @a[r=5] vehicle.pb389.adv_drive",
						"@s velocity_stationary"
					]
				}
			}
		},
		"controller.animation.pb389_soundstop2": {
			"states": {
				"default": {
					"transitions": [
						{
							"startup": "!query.has_rider"
						}
					]
				},
				"startup": {
					"transitions": [
						{
							"default": "query.has_rider"
						}
					],
					"on_entry": [
						"/stopsound @a[r=5] vehicle.pb389.adv_drive"
					]
				}
			}
		},
		"controller.animation.pb389_startup": {
			"states": {
				"default": {
					"transitions": [
						{
							"startup": "query.has_rider"
						}
					]
				},
				"startup": {
					"transitions": [
						{
							"default": "!query.has_rider"
						}
					],
					"on_entry": [
						"/playsound vehicle.pb389.startup @a[r=50] ~~~",
						"/playsound vehicle.pb389.horn @a[r=50] ~~~"
					]
				}
			}
		},
		"controller.animation.pb389_explode": {
			"states": {
				"default": {
					"transitions": [
						{
							"ono": "!query.is_alive"
						}
					]
				},
				"ono": {
					"transitions": [
						{
							"default": "query.is_alive"
						}
					],
					"on_entry": [
						"/summon ashminggu:vehicle_explosion",
						"/summon ashminggu:vehicle_explosion",
						"/particle minecraft:huge_explosion_emitter ~~~"
					]
				}
			}
		}     
	}
}