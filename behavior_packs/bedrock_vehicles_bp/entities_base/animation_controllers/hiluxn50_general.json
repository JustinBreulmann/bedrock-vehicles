{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.hiluxn50_startup": {
			"states": {
				"default": {
					"transitions": [
						{
							"startup": "query.has_rider"
						}
					]
				},
				"startup": {
					"transitions": [
						{
							"default": "!query.has_rider"
						}
					],
					"on_entry": [
						"/playsound vehicle.hiluxn50.startup @a[r=50] ~~~"
					]
				}
			}
		},
		"controller.animation.hiluxn50_meter": {
			"states": {
				"default": {
					"transitions": [
						{
							"meter": "query.ground_speed > 3"
						}
					]
				},
				"meter": {
					"transitions": [
						{
							"default": "query.ground_speed < 3"
						}
					],
					"on_entry": [
						"/function hiluxn50meter"
					]
				}
			}
		},
		"controller.animation.hiluxn50_pecutan": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "pecutan": "query.ground_speed > 3" 
                  }
               ]
            },
            "pecutan": {
               "transitions": [
                  {
                     "default": "query.ground_speed < 3"
                  }
               ],
               "on_entry": [
                  "@s velocity_1",
                  "/playsound vehicle.hiluxn50.adv_drive @a[r=2.4]"
               ]
            }
         }
      },
      "controller.animation.hiluxn50_soundstop": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "startup": "query.ground_speed < 3" 
                  }
               ]
            },
            "startup": {
               "transitions": [
                  {
                     "default": "query.ground_speed > 3"
                  }
               ],
               "on_entry": [
                  "/stopsound @a[r=5] vehicle.hiluxn50.adv_drive",
                  "@s velocity_stationary"
               ]
            }
         }
      },
      "controller.animation.hiluxn50_soundstop2": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "startup": "!query.has_rider"
                  }
               ]
            },
            "startup": {
               "transitions": [
                  {
                     "default": "query.has_rider"
                  }
               ],
               "on_entry": [
                  "/stopsound @a[r=5] vehicle.hiluxn50.adv_drive"
               ]
            }
         }
      },
      "controller.animation.hiluxn50_roadkill": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "roadkill": "query.ground_speed > 19" 
                  }
               ]
            },
            "roadkill": {
               "transitions": [
                  {
                     "default": "query.ground_speed > 19"
                  }
               ],
               "on_entry": [
                  "@s roadkill"
               ]
            }
         }
      },
      "controller.animation.hiluxn50_explode": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "ono": "!query.is_alive"
                  }
               ]
            },
            "ono": {
               "transitions": [
                  {
                     "default": "query.is_alive"
                  }
               ],
               "on_entry": [
                  "/summon ashminggu:vehicle_explosion",
                  "/summon ashminggu:vehicle_explosion",
                  "/particle minecraft:huge_explosion_emitter ~~~"
               ]
            }
         }
      }
	}
}