{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.pb389.general2": {
			"states": {
				"default": {
					"variables": {
						"moving_speed": {
							"input": "query.modified_move_speed"
						},
						"door": {
							"input": "query.has_rider"
						},
						"meter": {
							"input": "query.is_moving"
						},
						"wipers": {
							"input": "query.is_in_water_or_rain && query.has_rider"
						}, 
						"up": {
							"input": "query.ground_speed < 4.4"
						},
						"down": {
							"input": "query.ground_speed >= 4.4"
						}
					},
					"animations": [
						"turning",
						"open",
						{
							"drive": "variable.moving_speed"
						},
						{
							"door": "variable.door"
						},
						{
							"meter_player": "variable.meter"
						},
						{
							"meter_player2": "variable.meter"
						},
						{
							"wipers": "variable.wipers"
						},	
						{
							"up": "variable.up"
						},
						{
							"down": "variable.down"
						}
					]
				}
			}
		}
	}
}