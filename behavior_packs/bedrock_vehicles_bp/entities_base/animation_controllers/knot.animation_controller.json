{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.knot": {
			"states": {
				"default": {
					"transitions": [
						{
							"remove": "query.is_saddled"
						},
						{
							"none": "!query.is_saddled"
						}
					]
				},
				"none": {
					"transitions": [
						{
							"remove": "query.is_saddled"
						}
					]
				},
				"remove": {
					"transitions": [
						{
							"default": "query.is_saddled"
						},
						{
							"none": "!query.is_saddled"
						}
					],
					"on_entry": [
						"/execute @s ~~~ detect ~~~ air 0 tag @s add kill"
					]
				}
			}
		}
	}
}