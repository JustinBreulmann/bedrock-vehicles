{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "plane:smoke",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 4,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 5
			},
			"minecraft:emitter_shape_point": {
				"direction": [0, 0, 1]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size = 0.75 * math.pow(1.0-(variable.particle_age / variable.particle_lifetime), 0.08);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 3
			},
			"minecraft:particle_initial_speed": "Math.random(1, 2.0)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0, 0.4]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.1+variable.particle_random_1/6", "0.1+variable.particle_random_1/6"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 12,
					"uv": [0, "Math.floor(variable.particle_random_2 * 12)"],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_motion_collision": {
				"enabled": "variable.particle_age > 1",
				"collision_radius": 0.25
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, 0.54118]
			}
		}
	}
}