{
	"format_version" : "1.12.0",
	"animation_controllers" : {
				"controller.animation.smallplane_break.repair" : {
					"initial_state" : "zero",
					"states" : {
						"zero" : {
							"animations": ["death"],
							"on_entry": ["/particle minecraft:huge_explosion_emitter ~~1~"],
							"transitions": [
								{
									"repair": "query.any_animation_finished"
								}
							]
						},
						"repair": {
							"animations": ["repair"],
							"transitions": [
								{
									"fixed": "query.skin_id == 1"
								}
							]
						},
						"fixed": {
							"animations": ["fixed"]
						}
					}
				},
				"controller.animation.smallplane_break.death" : {
					"initial_state" : "alive",
					"states" : {
						"alive" : {
							"on_exit": ["/playsound block.cauldron.explode @a[r=20] ~~~ 2 1", "/particle minecraft:huge_explosion_emitter ~~1~", "/event entity @s turn_dead"],
							"transitions": [
								{
									"death": "!query.is_alive"
								}
							]
						},
						"death": {
						}
					}
				}
			}
		}